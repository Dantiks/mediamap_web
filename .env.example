# Скопировать в .env и заполнить. Файл .env в git не попадает.
#
# Обязательных здесь всего две строки — DATABASE_URL и SITE_URL. Всё
# остальное выключает часть возможностей, но сайт поднимается и работает.


# --- Обязательное ------------------------------------------------------

# База. На демо-стенде это файл рядом с проектом: одна строка, никакой
# отдельной службы. При переезде на Postgres меняется и адрес, и адаптер
# в src/lib/db.ts — см. docs/deploy.md.
DATABASE_URL="file:./prisma/dev.db"

# Адрес сайта целиком, со схемой и без косой черты на конце.
#
# Без него код падает обратно на http://localhost:3000 — и на сервере это
# ломает вход через Google (адрес возврата не совпадёт) и подставляет
# localhost в письма заявителям. Ошибка тихая: страницы открываются, а вход
# просто не работает.
SITE_URL="https://mediamap.kg"


# --- Разбор моделью ----------------------------------------------------

# ML-сервис из соседнего репозитория. Пусто — оценку снимает разбор по
# ключевым словам, сайт продолжает работать.
#
# Адрес именно локальный: у сервиса нет ни пароля, ни ограничения частоты,
# и наружу его выставлять нельзя — чужой запрос потратит наш ключ OpenAI.
ML_SERVICE_URL="http://127.0.0.1:8000"

# Ссылку сервис разбирает 10-30 секунд, снимок — около 10.
ML_SERVICE_TIMEOUT_MS="45000"

# Перевод новостей моделью NLLB. Первый запрос после запуска дольше на
# 20 секунд: модель грузится в память.
TRANSLATE_TIMEOUT_MS="60000"


# --- Ассистент на сайте ------------------------------------------------

# Кнопка «Спросить» в углу страницы. Отвечает модель через тот же
# ML-сервис, эндпоинт /chat: ключ OpenAI живёт там, сайт его не знает.
# Нужны оба условия — ML_SERVICE_URL и здесь 1. Иначе кнопки нет.
#
# Включать только когда в сервисе поднят /chat — договор описан в
# README, раздел «Ассистент». Без него каждый вопрос получит «недоступно».
ASSISTANT_ENABLED="0"

# Сколько ждём ответа целиком. Начинает он через секунду-две.
ASSISTANT_TIMEOUT_MS="30000"

# Сколько вопросов в час принимает весь сайт. Частоту одного человека
# держит свой счётчик; это — страховка счёта за модель, если спрашивать
# начнут сотней адресов разом.
ASSISTANT_HOURLY_CAP="300"


# --- Вход через соцсети ------------------------------------------------

# Нужен адрес возврата SITE_URL + /api/auth/google/callback, вписанный в
# консоли Google. Пусто — остаётся вход по почте и паролю.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""


# --- Письма заявителям -------------------------------------------------

# Извещение о решении по сообщению. Без SMTP_HOST письма не уходят и в
# журнал ложится строка — сайт из-за этого не ломается.
# SMTP_USER и SMTP_PASSWORD нужны только там, где сервер спрашивает вход.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="MediaMap <noreply@mediamap.kg>"

# --- Ключи сторонних сервисов ----------------------------------------

# Чем шифруются ключи доступа к сервисам проверки изображений, которые
# администратор вводит через панель. Они ложатся в базу, а класть чужие
# ключи туда открытым текстом нельзя: файл базы уезжает в резервную копию,
# а один потерянный архив это счёт за чужие запросы.
#
# Пусто — панель откажется сохранять ключи и скажет почему.
#
# Сгенерировать:  openssl rand -hex 32
#
# Менять нельзя без нужды: сохранённое старым ключом новым не открывается,
# и все заведённые ключи придётся вписать заново. Это не поломка, а то, что
# и должно происходить.
SECRETS_KEY=""


# --- Telegram-бот ----------------------------------------------------

# Общий секрет сайта и бота: им бот подписывает сообщения о нарушениях,
# которые отправляет в /api/intake/telegram. Тот же текст — в .env бота.
# Пусто — приём от бота выключен, адрес отвечает 404.
#
# Сгенерировать:  openssl rand -hex 32
BOT_INTAKE_SECRET=""
