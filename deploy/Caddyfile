# Caddy сам получает и продлевает сертификат Let's Encrypt — отдельной
# возни с certbot не нужно. Поменяйте домен и почту на свои.
mediamap.kg {
	encode zstd gzip

	# Вложения бывают тяжёлыми, а форма принимает до пяти файлов.
	request_body {
		max_size 60MB
	}

	# Приём от Telegram-бота — только с самой машины, бот ходит на
	# 127.0.0.1:3000 мимо Caddy. Снаружи этого адреса просто нет.
	respond /api/intake/* 404

	reverse_proxy 127.0.0.1:3000 {
		# Сайт по этому заголовку узнаёт адрес отправителя — на нём держится
		# ограничение частоты подачи. Без него все посетители выглядят как
		# один, и первый же спамер закрывает форму для всех.
		header_up X-Forwarded-For {remote_host}
	}
}
